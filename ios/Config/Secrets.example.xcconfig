// Template for the git-ignored Secrets.xcconfig. Copy it next to this file and fill in the app's
// Discogs key and secret (https://www.discogs.com/settings/developers, the same ones the Android app uses):
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Never commit Secrets.xcconfig.
DISCOGS_KEY = your-discogs-consumer-key
DISCOGS_SECRET = your-discogs-consumer-secret
